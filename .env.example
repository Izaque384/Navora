# Supabase PostgreSQL
# DATABASE_URL: Supavisor Transaction mode (port 6543) for application/serverless queries.
DATABASE_URL="postgres://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL: Supavisor Session mode (port 5432) for Prisma migrations.
DIRECT_URL="postgres://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:5432/postgres"
